for (dim : DIMENSIONS; spacedim : SPACE_DIMENSIONS; cgal_kernel : CGAL_KERNELS)
  {
#if dim <= spacedim
    template void
    dealii_cell_to_cgal_surface_mesh<typename cgal_kernel::Point_3,
                                     dim,
                                     spacedim>(
      const typename Triangulation<dim, spacedim>::cell_iterator &cell,
      const Mapping<dim, spacedim> &                              mapping,
      CGAL::Surface_mesh<typename cgal_kernel::Point_3> &         mesh);

    template void
    boolean_operation<typename cgal_kernel::Point_3, dim, spacedim>(
      const typename Triangulation<dim, spacedim>::cell_iterator &cell1,
      const typename Triangulation<dim, spacedim>::cell_iterator &cell2,
      CGAL::Surface_mesh<typename cgal_kernel::Point_3> &         outsm,
      const BooleanOperation &boolean_operation);

#endif
  }
for (cgal_kernel : CGAL_KERNELS)
  {
    template dealii::Quadrature<cgal_kernel::Point_3::Ambient_dimension::value>
    collect_quadratures_inside_surface<
      typename cgal_kernel::Point_3,
      typename CGAL::Triangulation_3<cgal_kernel>>(
      const CGAL::Surface_mesh<typename cgal_kernel::Point_3> &sm,
      const unsigned int                                       degree,
      CGAL::Triangulation_3<cgal_kernel> &                     tr);
  }